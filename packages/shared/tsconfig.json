{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "index.ts",
    "types/**/*.ts",
    "schemas/**/*.ts",
    "constants/**/*.ts",
    "generated/**/*.ts"
  ]
}
