# ============================================
# HealthLens Monorepo - .dockerignore
# ====================================
# Prevents sensitive files and build artifacts
# from being included in Docker build context

# Git
.git
.gitignore
.gitattributes

# IDE
.idea
.vscode
*.swp
*.swo
*.iml

# OS
.DS_Store
Thumbs.db

# Build artifacts
**/build
**/.gradle
**/dist
**/.next
**/out
**/.turbo
**/.cache

# Dependencies (will be reinstalled in Docker)
**/node_modules
**/.npm
.pnpm-store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Test reports
coverage/
.nyc_output
playwright-report/
test-results/

# Docker files (not needed in context)
**/Dockerfile
**/docker-compose*.yml
**/.dockerignore

# Documentation
*.md
docs/
README.md

# Development artifacts
.env
.env.local
.env.*.local
.env.development
.env.test

# CI/CD
.github/
.github Actions/

# Agent/Bot artifacts
**/_bmad/
**/_bmad-output/
**/.agent/
**/.cursor/

# Secrets (NEVER include)
**/*.pem
**/*.key
**/secrets/
**/credentials/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Database dumps / backups
*.dump
*.bak
