# Canonical site URL for sitemap.xml, metadataBase, and Open Graph (required in production).
# Must be a valid http(s) origin; bare hostnames get https:// prepended automatically.
NEXT_PUBLIC_SITE_URL=https://healthlens.vn

# App version shown on /settings/about (defaults to package.json version at build).
# NEXT_PUBLIC_APP_VERSION=0.1.0
# Optional CI build id for support tickets.
# NEXT_PUBLIC_BUILD_ID=
