# HealthLens Environment Variables Template
# ==========================================
#
# Option B+ Architecture (2026-04-01)
# Copy this file to .env and fill in your values
#
# DO NOT commit this file to version control with real values!

# =========================================
# APPLICATION
# =========================================
APP_NAME=healthlens
APP_ENV=development
SPRING_PROFILES_ACTIVE=dev

# =========================================
# DATABASE (Option B+: Neon PostgreSQL Cloud)
# =========================================
# Neon PostgreSQL - https://cloud.neon.tech
# Free tier: 512 MB storage, 1 project
#
# Local PostgreSQL (for offline development - optional):
# DATABASE_URL=jdbc:postgresql://localhost:5432/healthlens_dev

NEON_DATABASE_URL=postgresql://username:password@ep-xxxx-xxxx-xxxx.us-east-2.aws.neon.tech/healthlens?sslmode=require
NEON_HOST=ep-xxxx-xxxx-xxxx.us-east-2.aws.neon.tech
NEON_USER=your-username
NEON_PASSWORD=your-password

# =========================================
# AI SERVICES (Option B+: Cloud APIs)
# =========================================

# Groq API - https://console.groq.com
# Free tier: 14,400 requests/minute
# Models: qwen-2.5-72b-versatile, llama-3.3-70b-versatile
GROQ_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Embedding API Key (dùng cho EmbeddingService - KHÔNG phải Groq key!)
# Groq KHÔNG hỗ trợ embedding API. Cần provider riêng.
# Option 1: OpenAI (phải trả phí) - https://platform.openai.com/api-keys
# Option 2: Jina AI (1M tokens free) - https://jina.ai → đổi EMBEDDING_BASE_URL
# Option 3: Dùng placeholder nếu chưa cần embedding (Story 1.8 sẽ quyết định provider)
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_BASE_URL=https://api.openai.com
EMBEDDING_MODEL=text-embedding-3-small

# OpenRouter (Fallback LLM - optional)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =========================================
# VECTOR DATABASE (Option B+: Qdrant Cloud)
# =========================================
# Qdrant Cloud - https://cloud.qdrant.io
# Free tier: 1 cluster, 1 GB storage
# QUAN TRỌNG: QDRANT_HOST phải là hostname thuần, KHÔNG có https://
# Ví dụ: xxxx-xxxx.cloud.qdrant.io  (KHÔNG phải https://xxxx.cloud.qdrant.io)
QDRANT_HOST=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.cloud.qdrant.io
QDRANT_API_KEY=qdrant_api_key_xxxxxxxxxxxxxxxxxxxxxxxx

# =========================================
# OCR SERVICE (Option B+: EasyOCR + AWS)
# =========================================

# EasyOCR Service (local Python microservice)
# Runs on localhost:8001 via Docker Compose
OCR_SERVICE_URL=http://localhost:8001
OCR_TIMEOUT_MS=10000

# AWS Textract (Fallback OCR)
# https://aws.amazon.com/textract/
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=ap-southeast-1
S3_BUCKET=healthlens-ocr

# =========================================
# OBJECT STORAGE (S3/MinIO)
# =========================================

# For local development (MinIO via Docker)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=healthlens

# For production (AWS S3)
# AWS_S3_BUCKET=healthlens-prod
# AWS_S3_REGION=ap-southeast-1

# =========================================
# JWT AUTHENTICATION
# =========================================
JWT_SECRET=your-256-bit-secret-key-here-min-32-chars
JWT_ACCESS_TOKEN_EXPIRATION=900000  # 15 minutes in ms
JWT_REFRESH_TOKEN_EXPIRATION=604800000  # 7 days in ms

# =========================================
# EMAIL (SendGrid/AWS SES)
# =========================================
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=noreply@healthlens.vn

# =========================================
# PUSH NOTIFICATIONS (FCM/APNs)
# =========================================
# FCM_SERVER_KEY=your-firebase-server-key
# APNS_KEY_ID=your-apns-key-id
# APNS_TEAM_ID=your-team-id
# APNS_KEY_PATH=./config/apns-auth-key.p8

# =========================================
# REDIS (Optional - for caching)
# =========================================
# For MVP, can skip Redis and use in-memory caching
# REDIS_URL=redis://localhost:6379

# =========================================
# CORS & DOMAINS
# =========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
API_BASE_URL=http://localhost:8080

# =========================================
# LOGGING & MONITORING
# =========================================
LOG_LEVEL=INFO
