# ============================================
# HealthLens - Environment Configuration Template
# ============================================
#
# Copy this file to .env (.env.production) and configure.
# NEVER commit .env files to git!
#
# Usage:
#   Development:  cp .env.example .env
#   Production:   cp .env.example .env.production && edit .env.production

# ============================================
# Environment Mode
# ============================================
# Options: development | staging | production
APP_ENV=development
SPRING_PROFILES_ACTIVE=dev

# ============================================
# Application
# ============================================
APP_NAME=healthlens

# ============================================
# Database
# ============================================
# Development: Local Docker PostgreSQL
# Production:  Neon PostgreSQL Cloud

# --- Development (Docker PostgreSQL) ---
DB_HOST=postgres
DB_PORT=5432
DB_NAME=healthlens_dev
DB_USERNAME=healthlens
DB_PASSWORD=healthlens_dev_password
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# --- Production (Neon Cloud) ---
# Uncomment and use environment variables:
# DB_URL=${NEON_DATABASE_URL}
# DB_USERNAME=${NEON_USERNAME}
# DB_PASSWORD=${NEON_PASSWORD}

# ============================================
# Redis
# ============================================
# Development: Docker Redis
# Production:  Railway managed Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# Email
# ============================================
# Default provider: Brevo SMTP (works for dev/staging/prod with separate credentials).
# For local testing via Mailhog, override MAIL_HOST=localhost MAIL_PORT=1025 MAIL_USERNAME= MAIL_PASSWORD=
MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=HealthLens <contact@healthlens.vn>

# Mailhog UI / SMTP host ports (chỉ khi override compose)
# MAILHOG_SMTP_PORT=1025
# MAILHOG_UI_PORT=8025

# Email Stream (event-driven async delivery)
APP_STREAM_EMAIL_EVENTS=email.events
APP_STREAM_EMAIL_CONSUMER_GROUP=email-consumers
APP_STREAM_EMAIL_CONSUMER_NAME=api-email-consumer
APP_STREAM_EMAIL_POLL_DELAY_MS=1000

# ============================================
# Frontend URLs
# ============================================
WEB_BASE_URL=http://localhost:3000
WEB_VERIFY_URL=${WEB_BASE_URL}/verify-email
WEB_RESET_PASSWORD_URL=${WEB_BASE_URL}/reset-password
WEB_LOGIN_URL=${WEB_BASE_URL}/login

# ============================================
# API URLs
# ============================================
API_HOST=localhost
API_PORT=8080
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# ============================================
# MinIO (S3-compatible Storage)
# ============================================
# Development: Docker MinIO
# Production:  AWS S3 or compatible
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=healthlens-uploads

# ============================================
# Qdrant (Vector Database)
# ============================================
# Get from: https://cloud.qdrant.io/dashboard
QDRANT_HOST=https://xxx-xxx-12345.qdrant.io
QDRANT_PORT=6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=healthlens

# ============================================
# AI Chat Provider (OpenAI-compatible)
# ============================================
# Example: Groq uses an OpenAI-compatible endpoint.
AI_CHAT_PROVIDER=openai-compatible
AI_CHAT_API_KEY=your-ai-chat-api-key
AI_CHAT_BASE_URL=https://api.groq.com/openai
AI_CHAT_MODEL=qwen-2.5-72b-versatile
AI_CHAT_TIMEOUT_MS=30000
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# JWT Authentication
# ============================================
# Development: Short secret for testing
# Production:  Generate: openssl rand -base64 32
JWT_SECRET=dev-test-secret-key-minimum-32-characters-long
JWT_ACCESS_TTL=900000        # 15 minutes
JWT_REFRESH_TTL=604800000    # 7 days

# ============================================
# Security
# ============================================
# Development: false (localhost)
# Production:  MUST be true
APP_COOKIE_SECURE=false
APP_SECURITY_BLACKLIST_FAIL_CLOSED=false
APP_SECURITY_RATE_LIMIT_FAIL_CLOSED=false

# ============================================
# OCR Service
# ============================================
OCR_SERVICE_URL=http://localhost:8001
OCR_TIMEOUT_MS=10000
# OCR confidence thresholds (0.0 - 1.0)
OCR_CONFIDENCE_HIGH_THRESHOLD=0.85
OCR_CONFIDENCE_MEDIUM_THRESHOLD=0.50

# ============================================
# Docker Compose
# ============================================
COMPOSE_PROJECT_NAME=healthlens
COMPOSE_NETWORK=healthlens-network

# ============================================
# Logging
# ============================================
# Development: DEBUG
# Production:  WARN
LOG_LEVEL=DEBUG
